rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si eres el Súper Admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'danielalonzzo@icloud.com';
    }

    // Reglas para la colección de Miembros (Clientes)
    match /members/{userId} {
      allow read, write: if isSuperAdmin();
      // Permite leer y escribir si el UID coincide con el ID del documento
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para la colección de Licencias
    match /licenses/{licenseId} {
      allow read, write: if isSuperAdmin();
      // Cualquiera puede leer para validar la licencia antes del registro
      allow read: if true; 
      // PERMITIR ACTUALIZACIÓN: Un usuario recién registrado puede marcar SU licencia como usada
      allow update: if request.auth != null && 
                    resource.data.status == 'active' && 
                    request.resource.data.status == 'used';
    }

    // Reglas para el Onboarding (Formularios)
    match /onboarding_submissions/{submissionId} {
      allow read, write: if isSuperAdmin();
      // El usuario puede crear su envío si el userId coincide con su UID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Para leer (read), usamos 'resource.data' (el documento que ya existe en la BD)
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Reglas para los Prospectos (Formulario web)
    match /prospects/{prospectId} {
      allow read, write: if isSuperAdmin();
      // Permite a cualquier visitante (sin autenticar) crear un prospecto
      allow create: if true;
    }

    // Reglas para la colección de Contactos (Formulario web de contacto)
    match /contacts/{contactId} {
      allow read, write: if isSuperAdmin();
      // Permite a cualquier visitante (sin autenticar) enviar un mensaje de contacto
      allow create: if true;
    }
  }
}
