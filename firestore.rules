rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Functions ──────────────────────────────────────────────────────
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'danielalonzzo@icloud.com';
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Prevents users from self-modifying protected fields (subscription, role)
    // Only admin can write these
    function notModifyingProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['subscription', 'role']);
    }

    // ── Members (Partners / Clients) ──────────────────────────────────────────
    match /members/{userId} {
      allow read, write: if isSuperAdmin();
      allow read: if isOwner(userId);
      // On create: owner can create their own doc (initial registration)
      allow create: if isOwner(userId);
      // On update: owner can update ONLY non-protected fields
      allow update: if isOwner(userId) && notModifyingProtectedFields();
    }

    // ── Licenses (legacy pool — preserved as-is) ──────────────────────────────
    match /licenses/{licenseId} {
      allow read, write: if isSuperAdmin();
      allow read: if true; 
      allow update: if request.auth != null && 
                    resource.data.status == 'active' && 
                    request.resource.data.status == 'used';
    }

    // ── Onboarding Submissions ────────────────────────────────────────────────
    match /onboarding_submissions/{submissionId} {
      allow read, write: if isSuperAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // ── Prospects ────────────────────────────────────────────────────────────
    match /prospects/{prospectId} {
      allow read, write: if isSuperAdmin();
      allow create: if true;
    }

    // ── Contacts ─────────────────────────────────────────────────────────────
    match /contacts/{contactId} {
      allow read, write: if isSuperAdmin();
      allow create: if true;
    }

    // ── Subscription Payments ─────────────────────────────────────────────────
    // All payment records: manual (admin-assigned) + automatic (Stripe webhook)
    match /subscription_payments/{paymentId} {
      allow read, write: if isSuperAdmin();
      // Owner can only read their own payment records
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // No self-creation — payments created by admin or backend only
    }
  }
}
