GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
PUBLIC_BASE_URL=https://elysiumdr.eu
ALLOWED_ORIGINS=https://elysiumdr.eu,https://www.elysiumdr.eu,http://localhost:8787,http://localhost:8123,http://127.0.0.1:8123
PORT=4242
TRUST_PROXY_HOPS=1

# Comma-separated fallback allowlist. Prefer Firebase custom claims for teams.
ADMIN_EMAILS=danielalonzzo@icloud.com

# Transactional meeting and password-reset email (sender domain must be
# verified in Resend first).
RESEND_API_KEY=re_replace_me
MEETING_FROM_EMAIL=Elysium <meetings@elysiumdr.eu>
PASSWORD_RESET_FROM_EMAIL=Elysium Security <security@elysiumdr.eu>

# Where the administrator's own copy of every meeting notification goes.
# Falls back to the first entry in ADMIN_EMAILS when it is not set.
ADMIN_NOTIFICATION_EMAIL=danielalonzzo@icloud.com
