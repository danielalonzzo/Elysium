GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
PUBLIC_BASE_URL=https://elysiumdr.eu
ALLOWED_ORIGINS=https://elysiumdr.eu,https://www.elysiumdr.eu,http://localhost:8787,http://localhost:8123,http://127.0.0.1:8123
PORT=4242
TRUST_PROXY_HOPS=1

# Comma-separated fallback allowlist. Prefer Firebase custom claims for teams.
ADMIN_EMAILS=danielalonzzo@icloud.com

# Correo transaccional: sale del buzón de la empresa en IONOS por SMTP.
# El puerto 465 abre TLS directo; el 587 empieza en claro y sube con STARTTLS.
# La contraseña NO va aquí en producción: se inyecta desde Secret Manager.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=info@elysiumdr.eu
SMTP_PASSWORD=replace_me
# El remitente debe ser el propio buzón autenticado, o un alias suyo:
# IONOS rechaza enviar como una dirección que no le pertenece.
MEETING_FROM_EMAIL=Elysium <info@elysiumdr.eu>
PASSWORD_RESET_FROM_EMAIL=Elysium <info@elysiumdr.eu>

# Where the administrator's own copy of every meeting notification goes.
# Falls back to the first entry in ADMIN_EMAILS when it is not set.
ADMIN_NOTIFICATION_EMAIL=daniel.morales@elysiumdr.eu
