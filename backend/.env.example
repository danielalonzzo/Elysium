GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
PUBLIC_BASE_URL=https://elysiumdr.eu
ALLOWED_ORIGINS=https://elysiumdr.eu,https://www.elysiumdr.eu,https://crm.elysiumdr.eu,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://localhost:8123,http://127.0.0.1:8123
PORT=4242
TRUST_PROXY_HOPS=1

# Comma-separated fallback allowlist. Prefer Firebase custom claims for teams.
ADMIN_EMAILS=daniel.morales@elysiumdr.eu

# El CRM comparte Firebase Auth/Firestore con el portal real. Puede omitirse
# porque coincide con el proyecto por defecto; se deja explícito para impedir
# que un despliegue apunte accidentalmente a otro audience de ID tokens.
CRM_FIREBASE_PROJECT_ID=elysiumdr-eu

# Acceso corporativo al gestor privado de archivos. Los custom claims
# `crmAccess: true` + `crmTenantId: elysiumdr-eu` y `admin: true` también
# autorizan cuentas externas concretas.
CRM_EMAIL_DOMAINS=elysiumdr.eu
CRM_FILE_ROLES=admin,manager,agent,sales,operations
# Roles con acceso a archivos de cualquier entidad. Los demás sólo acceden
# a registros donde sean owner/assignee/creator o colaborador explícito.
CRM_FILE_GLOBAL_ROLES=manager,operations

# Cloudflare R2, bucket PRIVADO. Para residencia europea, crea el bucket con
# jurisdicción EU y usa el endpoint `.eu.r2.cloudflarestorage.com`. El token R2
# debe tener solamente Object Read & Write y estar limitado a este bucket.
# R2_SECRET_ACCESS_KEY va en Secret Manager (Cloud Run) o en un secreto 0600
# del VPS; nunca en el bundle frontend ni bajo un prefijo VITE_.
R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_BUCKET=elysium-crm-private
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_UPLOAD_URL_TTL_SECONDS=300
R2_DOWNLOAD_URL_TTL_SECONDS=90

# Configura además en R2: CORS PUT sólo desde los orígenes de Elysium, con
# Content-Type e If-None-Match; expón ETag y elimina `_quarantine/` al cabo de
# un día mediante Object Lifecycle. Mantén desactivados r2.dev y dominios
# públicos para este bucket.

# Correo transaccional: sale del buzón de la empresa en IONOS por SMTP.
# El puerto 465 abre TLS directo; el 587 empieza en claro y sube con STARTTLS.
# La contraseña NO va aquí en producción: se inyecta desde Secret Manager.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=info@elysiumdr.eu
SMTP_PASSWORD=replace_me
# El remitente debe ser el propio buzón autenticado, o un alias suyo:
# IONOS rechaza enviar como una dirección que no le pertenece.
MEETING_FROM_EMAIL=Elysium <info@elysiumdr.eu>
PASSWORD_RESET_FROM_EMAIL=Elysium <info@elysiumdr.eu>

# Where the administrator's own copy of every meeting notification goes.
# Falls back to the first entry in ADMIN_EMAILS when it is not set.
ADMIN_NOTIFICATION_EMAIL=daniel.morales@elysiumdr.eu

# Remitentes que ofrece la sección Mail del CRM. Es una lista CERRADA: el
# navegador manda una dirección, pero sólo sirve para elegir de aquí. Formato
# `Nombre <correo>`, separados por comas. Sin esta variable se usa el buzón de
# MEETING_FROM_EMAIL.
CRM_MAIL_SENDERS=Elysium <info@elysiumdr.eu>,Daniel Morales <daniel.morales@elysiumdr.eu>

# IONOS sólo deja enviar como el buzón autenticado o un alias suyo, así que cada
# remitente que sea un buzón distinto necesita sus propias credenciales. El
# sufijo es la parte local en mayúsculas, con los puntos en guiones bajos:
# daniel.morales@… → DANIEL_MORALES. Sin ellas, ese remitente aparece
# deshabilitado en el CRM en vez de fallar después de redactar el mensaje.
SMTP_USER_DANIEL_MORALES=daniel.morales@elysiumdr.eu
SMTP_PASSWORD_DANIEL_MORALES=replace_me

# Recordatorios de la agenda. Cloud Scheduler llama a
# POST /api/meetings/reminders/run y no puede iniciar sesión en Firebase, así
# que se identifica con este secreto en la cabecera `x-elysium-reminder-token`.
# Sin él, el endpoint solo acepta a un administrador autenticado.
MEETING_REMINDER_TOKEN=replace_me

# Zona con la que se fechan los acuses del CRM. Por defecto Europe/Lisbon.
ADMIN_TIME_ZONE=Europe/Lisbon
