# Auto detect text files and perform LF normalization
* text=auto

# Esta carpeta de la raíz es producto compilado, no código escrito a mano: la
# genera su proyecto en `Prototipos/`. Se versiona a propósito (el sitio se
# despliega desde el repositorio), pero marcarla como generada evita que
# `git diff` vuelque HTML minificado y chunks con hash cada vez que se recompila.
Demo-arbol/** linguist-generated=true
Demo-arbol/** -diff
Vet-Dr-Valladares/** linguist-generated=true
Vet-Dr-Valladares/** -diff

# tools.elysiumdr.eu lo genera scripts/build-tools.mjs. Es HTML legible y sus
# cambios conviene verlos al revisar, así que solo se marca como generado.
tools/** linguist-generated=true
