# Auto detect text files and perform LF normalization
* text=auto

# Estas dos carpetas de la raíz son producto compilado, no código escrito a mano:
# las generan sus proyectos en `Prototipos/`. Se versionan a propósito (el sitio
# se despliega desde el repositorio), pero marcarlas como generadas evita que
# `git diff` vuelque HTML minificado y chunks con hash cada vez que se recompila.
historia-de-costa-rica/** linguist-generated=true
historia-de-costa-rica/** -diff
puravidapets/** linguist-generated=true
puravidapets/** -diff
