{
  "name": "elysium",
  "compatibility_date": "2026-02-18",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Todo lo demás lo siguen sirviendo los assets tal cual, con su
    // html_handling por defecto (auto-trailing-slash). Solo /api/* pasa
    // primero por el Worker, que lo reenvía a elysium-billing.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
