{
  "name": "elysium",
  "compatibility_date": "2026-02-18",
  "main": "worker/index.js",
  "vars": {
    "ELYSIUM_API_ORIGIN": "https://elysium-billing-2w6h4dekoa-ew.a.run.app",
    // Las herramientas del CRM (backend/tools): descarga de videos y PDF a
    // Word. El Worker le manda /api/tools/*; el resto de /api/* va arriba.
    "ELYSIUM_TOOLS_ORIGIN": "https://elysium-tools-2w6h4dekoa-ew.a.run.app",
    // La clave pública (sitekey) del widget de Turnstile de tools.elysiumdr.eu.
    // La secreta va aparte: `npx wrangler secret put TURNSTILE_SECRET_KEY`,
    // igual que TOOLS_PUBLIC_GATEWAY_KEY. Sin las tres, la API pública de las
    // herramientas responde 503 y las páginas lo dicen (worker/tools-site.js).
    "TURNSTILE_SITE_KEY": ""
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Todo lo demás lo siguen sirviendo los assets tal cual, con su
    // html_handling por defecto (auto-trailing-slash). /api/* pasa primero por
    // el Worker, igual que las antiguas rutas localizadas del portal, que se
    // redirigen a la única página actual conservando el idioma.
    "run_worker_first": ["/*"]
  },
  // Los libros de /library (worker/library.js). Se suben desde el navegador,
  // así que no pueden vivir en el repositorio como el resto del sitio.
  "kv_namespaces": [
    { "binding": "LIBRARY", "id": "78ba1727173247dfab80e601d6a220b8" }
  ],
  "observability": { "enabled": true }
}
